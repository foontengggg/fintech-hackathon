<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MacroSignal — Macro Connector (ZIYAN)</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
/* ══════════════════════════════════════════
   RESET & ROOT
══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #0f1117;
  --bg-panel:  #161b24;
  --bg-card:   #1c2333;
  --bg-hover:  #222d3f;
  --border:    #2a3548;
  --border-l:  #344058;

  --text:      #c8d4e8;
  --text-dim:  #6b7a99;
  --text-faint:#3d4f6a;

  --red:       #e84040;
  --red-dim:   rgba(232,64,64,0.12);
  --green:     #2dd4a0;
  --green-dim: rgba(45,212,160,0.12);
  --yellow:    #f5a623;
  --yellow-dim:rgba(245,166,35,0.12);
  --blue:      #4a9eff;
  --blue-dim:  rgba(74,158,255,0.12);

  --node-entity: #e84040;
  --node-index:  #4a9eff;
  --node-macro:  #f5a623;

  --font-mono: 'IBM Plex Mono', monospace;
  --font-sans: 'IBM Plex Sans', sans-serif;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 13px;
  line-height: 1.5;
  min-height: 100vh;
}

/* ══════════════════════════════════════════
   DEMO WRAPPER — shows full right sidebar
   context like in the screenshot
══════════════════════════════════════════ */
.demo-page {
  display: grid;
  grid-template-columns: 1fr 340px;
  grid-template-rows: 48px 1fr;
  height: 100vh;
  max-width: 1280px;
  margin: 0 auto;
  gap: 0;
}

/* ── Top nav ── */
.topnav {
  grid-column: 1/-1;
  display: flex; align-items: center;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  padding: 0 20px;
  gap: 0;
}
.brand {
  font-family: var(--font-sans);
  font-weight: 700; font-size: 16px;
  color: #fff; letter-spacing: -0.02em;
  margin-right: 24px;
}
.brand span { color: var(--red); }
.platform-tag {
  font-family: var(--font-mono);
  font-size: 9px; letter-spacing: 0.18em;
  color: var(--text-dim);
  margin-right: auto;
}
.nav-tabs { display: flex; height: 100%; }
.nav-tab {
  font-family: var(--font-mono);
  font-size: 10px; letter-spacing: 0.1em;
  color: var(--text-dim);
  padding: 0 18px;
  display: flex; align-items: center;
  cursor: pointer; border: none;
  background: none;
  border-bottom: 2px solid transparent;
  transition: all 0.15s;
}
.nav-tab:hover { color: var(--text); }
.nav-tab.active {
  color: #fff; background: rgba(74,158,255,0.06);
  border-bottom-color: var(--blue);
}
.nav-live {
  display: flex; align-items: center; gap: 6px;
  font-family: var(--font-mono); font-size: 10px; color: var(--text-dim);
  margin-left: 20px;
}
.live-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 0 rgba(232,64,64,0.5);
  animation: livePulse 1.6s ease-in-out infinite;
}
@keyframes livePulse {
  0%,100%{box-shadow:0 0 0 0 rgba(232,64,64,0.5)}
  60%{box-shadow:0 0 0 6px rgba(232,64,64,0)}
}

/* ── Main + Sidebar layout ── */
.main-stub {
  background: var(--bg);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12px; padding: 40px;
  color: var(--text-faint);
}
.stub-label {
  font-family: var(--font-mono);
  font-size: 9px; letter-spacing: 0.2em;
  border: 1px solid var(--border);
  padding: 4px 12px; border-radius: 2px;
}
.stub-title { font-size: 15px; color: var(--text-dim); font-weight: 300; }

/* ══════════════════════════════════════════
   RIGHT SIDEBAR
══════════════════════════════════════════ */
.sidebar-right {
  background: var(--bg-panel);
  display: flex; flex-direction: column;
  overflow: hidden;
}

/* ══════════════════════════════════════════
   CROSS-ASSET LIQUIDITY PANEL
══════════════════════════════════════════ */
.cal-panel {
  padding: 14px 16px 10px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.panel-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12px;
}
.panel-title {
  font-family: var(--font-mono); font-size: 10px;
  font-weight: 600; letter-spacing: 0.15em;
  color: var(--text); text-transform: uppercase;
  display: flex; align-items: center; gap: 7px;
}
.panel-title-icon { color: var(--yellow); font-size: 13px; }
.panel-sub {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: 0.12em; color: var(--text-dim);
  text-align: right; line-height: 1.4;
}

/* 2×2 asset grid */
.asset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.asset-cell {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 10px 12px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  overflow: hidden;
}
.asset-cell::before {
  content:''; position: absolute;
  top:0; left:0; right:0; height: 2px;
  border-radius: 4px 4px 0 0;
  transition: opacity 0.3s;
}
.asset-cell.neg::before { background: var(--red); opacity: 0.8; }
.asset-cell.pos::before { background: var(--green); opacity: 0.8; }
.asset-cell:hover { border-color: var(--border-l); background: var(--bg-hover); }
.asset-cell.lit { border-color: var(--node-entity) !important; box-shadow: 0 0 12px rgba(232,64,64,0.15); }
.asset-cell.lit-blue { border-color: var(--blue) !important; box-shadow: 0 0 12px rgba(74,158,255,0.15); }

.cell-name {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: 0.12em; color: var(--text-dim);
  text-transform: uppercase; margin-bottom: 4px;
}
.cell-val {
  font-family: var(--font-mono); font-size: 20px;
  font-weight: 600; line-height: 1;
}
.cell-val.neg { color: var(--red); }
.cell-val.pos { color: var(--green); }
.cell-desc {
  font-family: var(--font-sans); font-size: 10px;
  color: var(--text-dim); margin-top: 4px;
}

/* Volatility bars */
.vol-section { margin-top: 12px; }
.vol-row {
  display: flex; align-items: center;
  gap: 8px; margin-bottom: 5px;
}
.vol-label {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-dim); width: 90px; flex-shrink: 0;
}
.vol-track {
  flex: 1; height: 3px; background: var(--bg-card);
  border-radius: 2px; overflow: hidden;
}
.vol-fill {
  height: 100%; border-radius: 2px;
  transition: width 0.8s cubic-bezier(.4,0,.2,1);
}
.vol-fill.red  { background: var(--red); }
.vol-fill.yellow { background: var(--yellow); }
.vol-fill.blue { background: var(--blue); }
.vol-fill.green { background: var(--green); }
.vol-pct {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-dim); width: 32px; text-align: right;
}

/* Credit spreads */
.credit-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 12px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  margin-top: 6px;
  cursor: pointer;
  transition: border-color 0.2s;
}
.credit-row:hover { border-color: var(--border-l); }
.credit-row.lit { border-color: var(--yellow); box-shadow: 0 0 10px rgba(245,166,35,0.12); }
.credit-label {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: 0.12em; color: var(--text-dim); text-transform: uppercase;
}
.credit-val {
  font-family: var(--font-mono); font-size: 15px;
  font-weight: 600; color: var(--yellow);
}
.credit-desc { font-size: 10px; color: var(--text-dim); margin-top: 1px; }

/* ══════════════════════════════════════════
   EVENT CONNECTOR PANEL
══════════════════════════════════════════ */
.ec-panel {
  flex: 1; display: flex; flex-direction: column;
  overflow: hidden; min-height: 0;
}
.ec-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px 8px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.ec-title {
  font-family: var(--font-mono); font-size: 10px;
  font-weight: 600; letter-spacing: 0.15em;
  color: var(--text); text-transform: uppercase;
  display: flex; align-items: center; gap: 7px;
}
.ec-title-icon { color: var(--text-dim); }
.ec-subtitle {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: 0.12em; color: var(--text-dim);
  text-align: right;
}

/* SVG canvas */
.connector-svg-wrap {
  flex: 1; position: relative; overflow: hidden;
  background: var(--bg);
  min-height: 220px;
}
.connector-svg {
  width: 100%; height: 100%;
  display: block;
}

/* Node tooltip */
.ec-tooltip {
  position: absolute;
  background: var(--bg-panel);
  border: 1px solid var(--border-l);
  border-radius: 4px;
  padding: 7px 10px;
  pointer-events: none;
  z-index: 10;
  font-family: var(--font-mono);
  font-size: 9px;
  min-width: 120px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.5);
  display: none;
}
.ec-tooltip-type { color: var(--text-faint); font-size: 8px; letter-spacing: 0.1em; margin-bottom: 2px; }
.ec-tooltip-name { color: #fff; font-size: 11px; font-weight: 600; margin-bottom: 5px; }
.ec-tooltip-stat { color: var(--text-dim); font-size: 8.5px; line-height: 1.8; }

/* Footer: impact score */
.ec-footer {
  padding: 8px 16px;
  border-top: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0;
  background: var(--bg-panel);
}
.ec-footer-left {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-dim); line-height: 1.6;
}
.ec-footer-score {
  font-family: var(--font-mono); font-size: 11px;
  font-weight: 700; letter-spacing: 0.1em;
}
.ec-footer-score.high { color: var(--red); }
.ec-footer-score.medium { color: var(--yellow); }
.ec-footer-score.low { color: var(--green); }

/* Selected node info bar */
.ec-selection {
  padding: 6px 16px;
  background: rgba(232,64,64,0.05);
  border-bottom: 1px solid rgba(232,64,64,0.15);
  display: none;
  flex-shrink: 0;
}
.ec-selection.visible { display: flex; align-items: center; justify-content: space-between; }
.ec-sel-label { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); }
.ec-sel-name { font-family: var(--font-mono); font-size: 10px; color: var(--red); font-weight: 600; }
.ec-sel-clear {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-faint); cursor: pointer;
  padding: 2px 6px; border-radius: 2px;
  border: 1px solid var(--border);
  background: none;
}
.ec-sel-clear:hover { color: var(--red); border-color: var(--red); }

/* Inject bar */
.ec-inject {
  padding: 8px 16px;
  border-top: 1px solid var(--border);
  display: flex; gap: 6px;
  flex-shrink: 0;
}
.ec-inject-input {
  flex: 1; background: var(--bg-card);
  border: 1px solid var(--border); border-radius: 3px;
  padding: 5px 10px; color: var(--text);
  font-family: var(--font-mono); font-size: 10px;
  outline: none;
}
.ec-inject-input::placeholder { color: var(--text-faint); }
.ec-inject-input:focus { border-color: var(--border-l); }
.ec-inject-btn {
  background: var(--red-dim); border: 1px solid rgba(232,64,64,0.3);
  color: var(--red); border-radius: 3px; padding: 5px 12px;
  font-family: var(--font-mono); font-size: 10px; cursor: pointer;
  transition: all 0.15s; white-space: nowrap;
}
.ec-inject-btn:hover { background: rgba(232,64,64,0.2); }

/* ══════════════════════════════════════════
   INJECT LOG (small headline feed)
══════════════════════════════════════════ */
.ec-log {
  max-height: 80px; overflow-y: auto;
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
.ec-log::-webkit-scrollbar { width: 2px; }
.ec-log::-webkit-scrollbar-thumb { background: var(--border-l); }
.ec-log-item {
  padding: 4px 16px;
  font-family: var(--font-mono); font-size: 8.5px;
  color: var(--text-dim); border-bottom: 1px solid var(--border);
  display: flex; gap: 8px; align-items: flex-start;
  animation: slideIn 0.25s ease;
}
@keyframes slideIn { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:none} }
.ec-log-tag {
  font-size: 7.5px; letter-spacing: 0.1em;
  padding: 1px 5px; border-radius: 2px; flex-shrink: 0;
  margin-top: 1px;
}
.tag-signal { background: var(--red-dim); border: 1px solid rgba(232,64,64,0.3); color: var(--red); }
.tag-warm { background: var(--yellow-dim); border: 1px solid rgba(245,166,35,0.3); color: var(--yellow); }
.tag-noise { background: rgba(107,122,153,0.1); border: 1px solid var(--border); color: var(--text-dim); }
.ec-log-text { line-height: 1.4; }
</style>
</head>
<body>
<div class="demo-page">

  <!-- ── Topnav ── -->
  <nav class="topnav">
    <div class="brand">Macro<span>Signal</span></div>
    <div class="platform-tag">SCHRODERS INTELLIGENCE PLATFORM</div>
    <div class="nav-tabs">
      <button class="nav-tab">Signal Feed</button>
      <button class="nav-tab active">Connector Graph</button>
      <button class="nav-tab">Memory Vault</button>
      <button class="nav-tab">Risk Reports</button>
    </div>
    <div class="nav-live">
      <span class="live-dot"></span>
      LIVE &nbsp;<span id="clock" style="color:var(--text)">16:23:44 UTC</span>
    </div>
  </nav>

  <!-- ── Main stub (KZ / ESTHER / FT panels) ── -->
  <div class="main-stub">
    <div class="stub-label">LEFT + CENTRE PANELS</div>
    <div class="stub-title">KZ · ESTHER · FT</div>
    <p style="font-size:11px;text-align:center;max-width:300px;color:var(--text-faint)">
      Signal Feed · Theme Tracker · AI Risk Strategist<br/>panels render here
    </p>
    <div style="margin-top:24px;display:flex;flex-direction:column;gap:8px;width:100%;max-width:360px;" id="demo-headlines">
      <div style="font-family:var(--font-mono);font-size:9px;letter-spacing:.15em;color:var(--text-faint);margin-bottom:4px;">INJECT HEADLINES TO TEST CONNECTOR ↓</div>
    </div>
  </div>

  <!-- ── Right Sidebar: ZIYAN's domain ── -->
  <aside class="sidebar-right">

    <!-- CROSS-ASSET LIQUIDITY -->
    <div class="cal-panel">
      <div class="panel-header">
        <div class="panel-title">
          <span class="panel-title-icon">⚡</span>
          CROSS-ASSET LIQUIDITY
        </div>
        <div class="panel-sub">LIVE MACRO<br/>IMPACT</div>
      </div>

      <div class="asset-grid">
        <div class="asset-cell" id="cell-equities" data-asset="equities">
          <div class="cell-name">EQUITIES</div>
          <div class="cell-val" id="val-equities">—</div>
          <div class="cell-desc" id="desc-equities">No signal</div>
        </div>
        <div class="asset-cell" id="cell-bonds" data-asset="bonds">
          <div class="cell-name">BONDS</div>
          <div class="cell-val" id="val-bonds">—</div>
          <div class="cell-desc" id="desc-bonds">No signal</div>
        </div>
        <div class="asset-cell" id="cell-fx" data-asset="fx">
          <div class="cell-name">FX</div>
          <div class="cell-val" id="val-fx">—</div>
          <div class="cell-desc" id="desc-fx">No signal</div>
        </div>
        <div class="asset-cell" id="cell-commodities" data-asset="commodities">
          <div class="cell-name">COMMODITIES</div>
          <div class="cell-val" id="val-commodities">—</div>
          <div class="cell-desc" id="desc-commodities">No signal</div>
        </div>
      </div>

      <div class="credit-row" id="cell-credit" data-asset="credit">
        <div>
          <div class="credit-label">CREDIT SPREADS</div>
          <div class="credit-desc" id="desc-credit">No signal</div>
        </div>
        <div class="credit-val" id="val-credit">—</div>
      </div>

      <div class="vol-section">
        <div class="vol-row">
          <div class="vol-label">Rate Volatility</div>
          <div class="vol-track"><div class="vol-fill red" id="vol-rate" style="width:42%"></div></div>
          <div class="vol-pct" id="vpct-rate">42%</div>
        </div>
        <div class="vol-row">
          <div class="vol-label">FX Vol (G10)</div>
          <div class="vol-track"><div class="vol-fill yellow" id="vol-fx" style="width:35%"></div></div>
          <div class="vol-pct" id="vpct-fx">35%</div>
        </div>
        <div class="vol-row">
          <div class="vol-label">Equity Vol</div>
          <div class="vol-track"><div class="vol-fill blue" id="vol-eq" style="width:38%"></div></div>
          <div class="vol-pct" id="vpct-eq">38%</div>
        </div>
        <div class="vol-row">
          <div class="vol-label">Credit Stress</div>
          <div class="vol-track"><div class="vol-fill green" id="vol-cr" style="width:25%"></div></div>
          <div class="vol-pct" id="vpct-cr">25%</div>
        </div>
      </div>
    </div>

    <!-- EVENT CONNECTOR -->
    <div class="ec-panel">
      <div class="ec-header">
        <div class="ec-title">
          <span class="ec-title-icon">🔗</span>
          EVENT CONNECTOR
        </div>
        <div class="ec-subtitle">MACRO LINKS</div>
      </div>

      <div class="ec-selection" id="ec-selection">
        <div>
          <div class="ec-sel-label">SELECTED</div>
          <div class="ec-sel-name" id="ec-sel-name">—</div>
        </div>
        <button class="ec-sel-clear" id="ec-sel-clear">✕ CLEAR</button>
      </div>

      <div class="connector-svg-wrap" id="svg-wrap">
        <svg class="connector-svg" id="connector-svg">
          <defs>
            <filter id="f-glow-red">
              <feGaussianBlur stdDeviation="3" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="f-glow-blue">
              <feGaussianBlur stdDeviation="3" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="f-glow-yellow">
              <feGaussianBlur stdDeviation="2.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="f-glow-node">
              <feGaussianBlur stdDeviation="4" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <marker id="arr-red" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
              <path d="M0,0 L5,2.5 L0,5 Z" fill="#e84040" opacity="0.8"/>
            </marker>
            <marker id="arr-blue" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
              <path d="M0,0 L5,2.5 L0,5 Z" fill="#4a9eff" opacity="0.8"/>
            </marker>
            <marker id="arr-yellow" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
              <path d="M0,0 L5,2.5 L0,5 Z" fill="#f5a623" opacity="0.8"/>
            </marker>
          </defs>
        </svg>
        <div class="ec-tooltip" id="ec-tooltip">
          <div class="ec-tooltip-type" id="tip-type"></div>
          <div class="ec-tooltip-name" id="tip-name"></div>
          <div class="ec-tooltip-stat" id="tip-stat"></div>
        </div>
      </div>

      <div class="ec-footer">
        <div class="ec-footer-left" id="ec-footer-left">
          0 macro events linked<br/>
          Combined impact score:
        </div>
        <div class="ec-footer-score" id="ec-footer-score">—</div>
      </div>

      <div class="ec-inject">
        <input class="ec-inject-input" id="ec-inject-input"
          placeholder="Paste headline… e.g. TSMC cuts Q3 guidance"/>
        <button class="ec-inject-btn" onclick="injectHeadline()">LINK ↗</button>
      </div>

      <div class="ec-log" id="ec-log"></div>
    </div>

  </aside>
</div>

<script>
// ═══════════════════════════════════════════════════════════
//  KNOWLEDGE GRAPH — Entity → Asset Mapping
//  This is the backend logic running in the browser for demo.
//  In production: POST to /api/macro-connector (Edge Function)
// ═══════════════════════════════════════════════════════════

const KG = {
  "TSMC":            { assets:["equities","credit"], indices:["SOX Index","TAIEX"], direction:"negative", strength:0.9, label:"Taiwan fab capacity risk" },
