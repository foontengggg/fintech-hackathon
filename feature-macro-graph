// ═══════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════
let currentGraph = { nodes:[], edges:[], entities:[], headlines:[] };
let selectedNodeId = null;

// ═══════════════════════════════════════════
//  PARSE HEADLINE → GRAPH
// ═══════════════════════════════════════════
function parseHeadline(text) {
  const lower = text.toLowerCase();
  const matched = [];
  for (const [kw, data] of Object.entries(KG)) {
    if (lower.includes(kw.toLowerCase())) {
      matched.push({ keyword: kw, ...data });
    }
  }
  return matched;
}

function buildGraph(headlines) {
  const entityMap = new Map();
  const assetMap  = new Map();
  const indexMap  = new Map();
  const edges     = [];

  for (const h of headlines) {
    const matches = parseHeadline(h);
    for (const m of matches) {
      // entity node
      if (!entityMap.has(m.keyword)) {
        entityMap.set(m.keyword, {
          id: `e:${m.keyword}`, label: m.keyword, type:'entity',
          direction: m.direction, strength: m.strength,
          assetLabel: m.label, count: 0
        });
      }
      entityMap.get(m.keyword).count++;
      entityMap.get(m.keyword).strength = Math.min(1, entityMap.get(m.keyword).strength + 0.05);

      // asset nodes
      for (const a of m.assets) {
        if (!assetMap.has(a)) assetMap.set(a, { id:`a:${a}`, label: a.toUpperCase(), type:'asset', direction: m.direction, strength: m.strength });
        edges.push({ src:`e:${m.keyword}`, tgt:`a:${a}`, direction: m.direction, strength: m.strength });
      }

      // index nodes
      for (const ix of m.indices) {
        if (!indexMap.has(ix)) indexMap.set(ix, { id:`i:${ix}`, label: ix, type:'index', direction: m.direction, strength: m.strength * 0.8 });
        edges.push({ src:`e:${m.keyword}`, tgt:`i:${ix}`, direction: m.direction, strength: m.strength * 0.75 });
      }
    }
  }

  return {
    nodes: [...entityMap.values(), ...assetMap.values(), ...indexMap.values()],
    edges,
    entities: [...entityMap.values()],
    headlines
  };
}

// ═══════════════════════════════════════════
//  LAYOUT ENGINE
//  Entities: center cluster
//  Assets: left arc (fixed positions matching asset grid)
//  Indices: right arc
// ═══════════════════════════════════════════
function computeLayout(nodes, w, h) {
  const pos = new Map();
  const cx = w/2, cy = h/2;

  const entities = nodes.filter(n=>n.type==='entity');
  const assets   = nodes.filter(n=>n.type==='asset');
  const indices  = nodes.filter(n=>n.type==='index');

  // Entities — center with slight spread
  entities.forEach((n,i) => {
    const angle = (2*Math.PI*i/Math.max(entities.length,1)) - Math.PI/2;
    const r = entities.length <= 1 ? 0 : Math.min(38, 18*entities.length);
    pos.set(n.id, {
      x: cx + r*Math.cos(angle) + (Math.random()-0.5)*8,
      y: cy + r*Math.sin(angle) + (Math.random()-0.5)*8
    });
  });

  // Assets — left arc
  const assetAngles = [-2.0, -2.5, -1.5, -2.8, -1.2];
  assets.forEach((n,i) => {
    const angle = assetAngles[i] ?? (2*Math.PI*i/assets.length);
    const r = w * 0.32;
    pos.set(n.id, { x: cx + r*Math.cos(angle), y: cy + r*Math.sin(angle) });
  });

  // Indices — right arc
  indices.forEach((n,i) => {
    const angle = (Math.PI*i/(Math.max(indices.length,1)+1)) - Math.PI*0.1;
    const r = w * 0.34;
    pos.set(n.id, { x: cx + r*Math.cos(angle), y: cy + r*Math.sin(angle) });
  });

  return pos;
}

// ═══════════════════════════════════════════
//  SVG RENDER
// ═══════════════════════════════════════════
function renderSVG() {
  const wrap = document.getElementById('svg-wrap');
  const svg  = document.getElementById('connector-svg');
  const w = wrap.clientWidth, h = wrap.clientHeight;
  svg.setAttribute('viewBox', `0 0 ${w} ${h}`);

  const defs = svg.querySelector('defs');
  svg.innerHTML = '';
  svg.appendChild(defs);

  if (!currentGraph.nodes.length) {
    // Empty state
    const txt = makeSVG('text');
    txt.setAttribute('x', w/2); txt.setAttribute('y', h/2);
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('font-family','IBM Plex Mono, monospace');
    txt.setAttribute('font-size','10');
    txt.setAttribute('fill','#3d4f6a');
    txt.setAttribute('letter-spacing','0.15em');
    txt.textContent = 'INJECT A HEADLINE TO ACTIVATE';
    svg.appendChild(txt);
    updateFooter(0, '—');
    return;
  }

  const pos = computeLayout(currentGraph.nodes, w, h);

  // ── Edges ──
  const edgeG = makeSVG('g');
  for (const edge of currentGraph.edges) {
    const s = pos.get(edge.src), t = pos.get(edge.tgt);
    if (!s || !t) continue;

    const color = edge.direction==='positive' ? '#2dd4a0'
                : edge.direction==='negative' ? '#e84040' : '#6b7a99';
    const marker = edge.direction==='positive' ? 'arr-blue'
                 : edge.direction==='negative' ? 'arr-red' : 'arr-yellow';
    const opacity = 0.2 + edge.strength * 0.55;
    const sw = 0.8 + edge.strength * 1.6;

    const dx = t.x-s.x, dy = t.y-s.y;
    const mx = s.x+dx/2, my = s.y+dy/2 - Math.abs(dx)*0.12;

    const dimmed = selectedNodeId && selectedNodeId !== edge.src && selectedNodeId !== edge.tgt;

    const path = makeSVG('path');
    path.setAttribute('d', `M${s.x},${s.y} Q${mx},${my} ${t.x},${t.y}`);
    path.setAttribute('fill','none');
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', sw);
    path.setAttribute('stroke-dasharray', edge.direction==='neutral'?'4,3':'none');
    path.setAttribute('opacity', dimmed ? '0.04' : opacity);
    path.setAttribute('marker-end', `url(#${marker})`);
    if (edge.strength > 0.75 && !dimmed) {
      path.setAttribute('filter', edge.direction==='negative'?'url(#f-glow-red)':'url(#f-glow-blue)');
    }
    path.dataset.src = edge.src; path.dataset.tgt = edge.tgt;

    // Flow animation on strong edges
    if (edge.strength > 0.6 && edge.direction !== 'neutral') {
      const len = Math.hypot(dx,dy);
      path.setAttribute('stroke-dasharray', `${len*0.15},${len*0.85}`);
      const anim = makeSVG('animate');
      anim.setAttribute('attributeName','stroke-dashoffset');
      anim.setAttribute('from','0'); anim.setAttribute('to',`-${len}`);
      anim.setAttribute('dur', `${1.5 + (1-edge.strength)*1.5}s`);
      anim.setAttribute('repeatCount','indefinite');
      path.appendChild(anim);
    }

    edgeG.appendChild(path);
  }
  svg.appendChild(edgeG);

  // ── Nodes ──
  const nodeG = makeSVG('g');
  for (const node of currentGraph.nodes) {
    const p = pos.get(node.id);
    if (!p) continue;

    const color = node.type==='entity' ? '#e84040'
                : node.type==='asset'  ? '#4a9eff' : '#f5a623';
    const r = node.type==='entity' ? 14 + (node.count||0)*1.5
            : node.type==='asset'  ? 11 : 9;
    const isSelected = selectedNodeId === node.id;
    const dimmed = selectedNodeId && !isSelected;

    const g = makeSVG('g');
    g.style.cursor = 'pointer';
    g.style.opacity = dimmed ? '0.2' : '1';

    // Pulse ring on entities
    if (node.type === 'entity') {
      const ring = makeSVG('circle');
      ring.setAttribute('cx',p.x); ring.setAttribute('cy',p.y); ring.setAttribute('r',r+8);
      ring.setAttribute('fill','none'); ring.setAttribute('stroke',color);
      ring.setAttribute('stroke-width','1'); ring.setAttribute('opacity','0.15');
      const a = makeSVG('animate');
      a.setAttribute('attributeName','r');
      a.setAttribute('values',`${r+5};${r+14};${r+5}`);
      a.setAttribute('dur', `${1.8+Math.random()*0.5}s`);
      a.setAttribute('repeatCount','indefinite');
      ring.appendChild(a); g.appendChild(ring);
    }

    const circle = makeSVG('circle');
    circle.setAttribute('cx',p.x); circle.setAttribute('cy',p.y); circle.setAttribute('r',r);
    circle.setAttribute('fill', node.type==='entity' ? `rgba(232,64,64,0.15)` : node.type==='asset' ? `rgba(74,158,255,0.12)` : `rgba(245,166,35,0.1)`);
    circle.setAttribute('stroke', color);
    circle.setAttribute('stroke-width', isSelected ? '2.5' : '1.2');
    circle.setAttribute('filter', 'url(#f-glow-node)');

    const label = makeSVG('text');
    label.setAttribute('x',p.x); label.setAttribute('y', p.y+r+12);
    label.setAttribute('text-anchor','middle');
    label.setAttribute('font-size', node.type==='entity'?'9.5':'8');
    label.setAttribute('font-family','IBM Plex Mono, monospace');
    label.setAttribute('fill', color);
    label.setAttribute('opacity', node.type==='entity'?'1':'0.85');
    label.setAttribute('pointer-events','none');
    label.setAttribute('letter-spacing','0.05em');
    const ltext = node.label.length > 10 ? node.label.slice(0,9)+'…' : node.label;
    label.textContent = ltext;

    g.appendChild(circle); g.appendChild(label);

    g.addEventListener('mouseenter', e => showTooltip(e, node, p, w, h));
    g.addEventListener('mouseleave', hideTooltip);
    g.addEventListener('click', () => selectNode(node.id));

    nodeG.appendChild(g);
  }
  svg.appendChild(nodeG);

  // Update footer
  const entityCount = currentGraph.entities.length;
  const maxStrength = currentGraph.nodes.reduce((m,n)=>Math.max(m,n.strength||0),0);
  const score = maxStrength > 0.85 ? 'HIGH' : maxStrength > 0.6 ? 'MEDIUM' : 'LOW';
  updateFooter(entityCount, score);
  updateAssetCells();
}

function makeSVG(tag) {
  return document.createElementNS('http://www.w3.org/2000/svg', tag);
}

// ═══════════════════════════════════════════
//  ASSET IMPACT ENGINE
//  Each asset class has baseline sensitivity
//  weights per entity direction. When headlines
//  fire entities, we accumulate weighted impact
//  scores and convert to realistic % / bp moves.
// ═══════════════════════════════════════════

// How much each asset CLASS moves (in %) per
// unit of signal strength, split by direction.
const ASSET_SENSITIVITY = {
  equities:    { neg: -4.5, pos: +3.2, vol: 'vol-eq',   vpct: 'vpct-eq',   baseVol: 55, volScale: 28 },
  bonds:       { neg: -3.8, pos: +2.1, vol: 'vol-rate',  vpct: 'vpct-rate', baseVol: 60, volScale: 32 },
  fx:          { neg: -2.2, pos: +2.6, vol: 'vol-fx',    vpct: 'vpct-fx',   baseVol: 40, volScale: 22 },
  commodities: { neg: -2.8, pos: +5.1, vol: 'vol-rate',  vpct: 'vpct-rate', baseVol: 45, volScale: 25 },
  credit:      { neg: +28,  pos: -8,   vol: 'vol-cr',    vpct: 'vpct-cr',   baseVol: 30, volScale: 40 },
  // credit is in basis points, so scale differs
};

// Human-readable descriptions per asset × direction
const ASSET_DESCS = {
  equities: {
    neg: ['SPX sell-off', 'Risk-off equity flight', 'Tech drag on indices', 'EM equities under pressure'],
    pos: ['SPX bid', 'Risk-on equity rally', 'Earnings-driven upside', 'Broad market lift'],
    neu: ['Equities range-bound', 'Mixed equity signals']
  },
  bonds: {
    neg: ['Duration sell-off', 'Yield spike — watch 10Y', 'Bond market repricing', 'Treasury selldown'],
    pos: ['Flight to safety', 'Duration bid', 'Yield compression', 'Safe-haven Treasury bid'],
    neu: ['Rates range-bound', 'Bond markets steady']
  },
  fx: {
    neg: ['DXY weakening', 'EM FX under pressure', 'EUR/USD stress', 'Dollar softening'],
    pos: ['DXY strength', 'Safe-haven USD bid', 'G10 FX divergence', 'Dollar strengthening'],
    neu: ['FX markets mixed', 'G10 consolidation']
  },
  commodities: {
    neg: ['Commodity demand shock', 'Energy selloff', 'Base metals weak', 'Supply glut fears'],
    pos: ['Oil / Gold ↑', 'Supply-driven commodity bid', 'Energy rally', 'Metals complex higher'],
    neu: ['Commodities stable', 'Mixed commodity signals']
  },
  credit: {
    neg: ['IG widening — watch HY', 'Credit stress building', 'Spread widening signal', 'HY under pressure'],
    pos: ['Credit spreads tightening', 'IG compression', 'Risk-on credit', 'Spread rally'],
    neu: ['Credit spreads stable', 'IG/HY neutral']
  },
};

function calcAssetImpact() {
  // Accumulate weighted signal per asset
  const scores = {};
  const entityLabels = {};
  for (const asset of Object.keys(ASSET_SENSITIVITY)) {
    scores[asset] = { posWeight: 0, negWeight: 0, neuWeight: 0, topEntities: [] };
  }

  for (const entity of currentGraph.entities) {
    const kgEntry = KG[entity.label];
    if (!kgEntry) continue;
    const s = entity.strength;
    const dir = entity.direction;

    for (const asset of kgEntry.assets) {
      if (!scores[asset]) continue;
      scores[asset].topEntities.push(entity.label);
      if (dir === 'positive')     scores[asset].posWeight += s;
      else if (dir === 'negative') scores[asset].negWeight += s;
      else                         scores[asset].neuWeight += s * 0.5;
    }
  }

  return scores;
}

function updateAssetCells() {
  const scores = calcAssetImpact();

  // Reset border classes
  Object.values(ASSET_CONFIG).forEach(cfg => {
    const el = document.getElementById(cfg.el);
    if (el) el.classList.remove('neg','pos','lit','lit-blue');
  });

  const volAccum = { 'vol-eq':0, 'vol-rate':0, 'vol-fx':0, 'vol-cr':0 };
  const volCount = { 'vol-eq':0, 'vol-rate':0, 'vol-fx':0, 'vol-cr':0 };

  for (const [asset, score] of Object.entries(scores)) {
    const sens = ASSET_SENSITIVITY[asset];
    const cfg  = ASSET_CONFIG[asset];
    if (!cfg || !sens) continue;

    const netPos = score.posWeight;
    const netNeg = score.negWeight;
    const total  = netPos + netNeg + score.neuWeight;

    const valEl   = document.getElementById(`val-${asset === 'credit' ? 'credit' : asset}`);
    const descEl  = document.getElementById(`desc-${asset === 'credit' ? 'credit' : asset}`);
    const cellEl  = document.getElementById(cfg.el);

    if (total === 0) {
      // No signal — reset
      if (valEl) { valEl.textContent = '—'; valEl.className = 'cell-val'; }
      if (asset === 'credit' && valEl) valEl.className = 'credit-val';
      if (descEl) descEl.textContent = 'No signal';
      continue;
    }

    // Net direction: positive wins if posWeight > negWeight
    const netDir = netPos > netNeg ? 'positive' : netNeg > netPos ? 'negative' : 'neutral';
    const dominantWeight = Math.max(netPos, netNeg, score.neuWeight);

    // Calculate move magnitude
    let move;
    if (asset === 'credit') {
      // Credit in basis points
      move = netDir === 'negative' ? sens.neg * dominantWeight
           : netDir === 'positive' ? sens.pos * dominantWeight
           : 0;
      move = Math.round(Math.max(-80, Math.min(80, move)));
      const sign = move >= 0 ? '+' : '';
      if (valEl) { valEl.textContent = `${sign}${move}bp`; valEl.className = 'credit-val' + (netDir==='negative'?' neg':netDir==='positive'?' pos':''); }
      if (cellEl) cellEl.classList.add(netDir === 'negative' ? 'lit' : netDir === 'positive' ? 'lit-blue' : '');
    } else {
      // % move
      move = netDir === 'negative' ? sens.neg * dominantWeight
           : netDir === 'positive' ? sens.pos * dominantWeight
           : 0;
      move = Math.max(-12, Math.min(12, move));
      const sign = move >= 0 ? '+' : '';
      const formatted = `${sign}${move.toFixed(1)}%`;
      if (valEl) {
        valEl.textContent = formatted;
        valEl.className = 'cell-val ' + (netDir === 'negative' ? 'neg' : netDir === 'positive' ? 'pos' : '');
      }
      if (cellEl) {
        cellEl.classList.add(netDir === 'negative' ? 'neg' : netDir === 'positive' ? 'pos' : '');
        cellEl.classList.add(asset === 'bonds' || asset === 'fx' ? 'lit-blue' : 'lit');
      }
    }

    // Description — pick from pool based on top entity
    const descPool = ASSET_DESCS[asset]?.[netDir === 'positive' ? 'pos' : netDir === 'negative' ? 'neg' : 'neu'] ?? [];
    const topEntity = score.topEntities[0] ?? '';
    const descIdx = Math.abs(topEntity.charCodeAt(0) ?? 0) % Math.max(descPool.length, 1);
    if (descEl && descPool.length) descEl.textContent = descPool[descIdx];

    // Accumulate vol for bars
    const volBar = sens.vol;
    if (volBar in volAccum) {
      volAccum[volBar] += dominantWeight;
      volCount[volBar]++;
    }
  }

  // Vol bars: baseline + signal-driven boost, capped at 99%
  const VOL_BASELINES = { 'vol-eq': 38, 'vol-rate': 42, 'vol-fx': 35, 'vol-cr': 25 };
  const VOL_IDS = {
    'vol-eq':   { bar:'vol-eq',   pct:'vpct-eq'   },
    'vol-rate': { bar:'vol-rate', pct:'vpct-rate'  },
    'vol-fx':   { bar:'vol-fx',   pct:'vpct-fx'    },
    'vol-cr':   { bar:'vol-cr',   pct:'vpct-cr'    },
  };

  for (const [volKey, ids] of Object.entries(VOL_IDS)) {
    const base  = VOL_BASELINES[volKey];
    const boost = Math.min(55, volAccum[volKey] * 22);
    animateVol(ids.bar, ids.pct, Math.min(99, base + boost));
  }
}

function animateVol(barId, pctId, pct) {
  const bar = document.getElementById(barId);
  const lbl = document.getElementById(pctId);
  if (bar) bar.style.width = pct + '%';
  if (lbl) lbl.textContent = Math.round(pct) + '%';
}

// ═══════════════════════════════════════════
//  FOOTER & SELECTION
// ═══════════════════════════════════════════
function updateFooter(count, score) {
  document.getElementById('ec-footer-left').innerHTML =
    `${count} macro event${count!==1?'s':''} linked<br/>Combined impact score:`;
  const scoreEl = document.getElementById('ec-footer-score');
  scoreEl.textContent = score;
  scoreEl.className = 'ec-footer-score ' + score.toLowerCase();
}

function selectNode(id) {
  selectedNodeId = selectedNodeId === id ? null : id;
  const node = currentGraph.nodes.find(n=>n.id===id);
  const sel = document.getElementById('ec-selection');
  if (selectedNodeId && node) {
    sel.classList.add('visible');
    document.getElementById('ec-sel-name').textContent = `${node.label} [${node.type.toUpperCase()}]`;
  } else {
    sel.classList.remove('visible');
  }
  renderSVG();
}

document.getElementById('ec-sel-clear').addEventListener('click', () => {
  selectedNodeId = null;
  document.getElementById('ec-selection').classList.remove('visible');
  renderSVG();
});

// ═══════════════════════════════════════════
//  TOOLTIP
// ═══════════════════════════════════════════
function showTooltip(e, node, pos, svgW, svgH) {
  const tip = document.getElementById('ec-tooltip');
  const wrap = document.getElementById('svg-wrap');
  const rect = wrap.getBoundingClientRect();

  const edges = currentGraph.edges.filter(ed=>ed.src===node.id||ed.tgt===node.id);
  document.getElementById('tip-type').textContent = node.type.toUpperCase();
  document.getElementById('tip-name').textContent = node.label;
  document.getElementById('tip-stat').innerHTML =
    `Signal: ${Math.round((node.strength||0)*100)}%<br/>` +
    `Links: ${edges.length}<br/>` +
    (node.assetLabel ? `Note: ${node.assetLabel}` : `Direction: ${node.direction||'neutral'}`);

  tip.style.display = 'block';
  const tx = e.clientX - rect.left + 12;
  const ty = e.clientY - rect.top - 10;
  tip.style.left = Math.min(tx, rect.width - 140) + 'px';
  tip.style.top = Math.max(0, ty) + 'px';
}
function hideTooltip() {
  document.getElementById('ec-tooltip').style.display = 'none';
}

// ═══════════════════════════════════════════
//  HEADLINE INJECTION
// ═══════════════════════════════════════════
function injectHeadline(text) {
  const input = document.getElementById('ec-inject-input');
  const h = text || input.value.trim();
  if (!h) return;
  input.value = '';

  currentGraph.headlines.push(h);
  currentGraph = buildGraph(currentGraph.headlines);
  renderSVG();
  addLogItem(h);
  updateDemoFeed(h);
}

function addLogItem(text) {
  const matches = parseHeadline(text);
  const tag = matches.length >= 2 ? 'signal'
             : matches.length === 1 ? 'warm' : 'noise';
  const tagLabels = { signal:'✦ SIGNAL', warm:'▲ WARM', noise:'— NOISE' };

  const log = document.getElementById('ec-log');
  const item = document.createElement('div');
  item.className = 'ec-log-item';
  item.innerHTML = `
    <span class="ec-log-tag tag-${tag}">${tagLabels[tag]}</span>
    <span class="ec-log-text">${text.length>80?text.slice(0,79)+'…':text}</span>
  `;
  log.prepend(item);
  if (log.children.length > 6) log.lastChild?.remove();
}

function updateDemoFeed(text) {
  const feed = document.getElementById('demo-headlines');
  const el = document.createElement('div');
  el.style.cssText = 'font-size:11px;color:#6b7a99;padding:4px 8px;background:#161b24;border:1px solid #2a3548;border-radius:3px;font-family:IBM Plex Mono,monospace;';
  el.textContent = '↳ ' + (text.length>60?text.slice(0,59)+'…':text);
  feed.appendChild(el);
}

// ═══════════════════════════════════════════
//  PRESET DEMO HEADLINES
// ═══════════════════════════════════════════
const DEMO_HEADLINES = [
  { text:"TSMC guidance cut 8% — Taiwan fab capacity flagged as constrained through Q3; US chip stocks diverge sharply", delay:300 },
  { text:"US CPI prints 3.8% — above consensus 3.4%; shelter and services components drive surprise to upside", delay:1400 },
