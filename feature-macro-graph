  { text:"OPEC+ unexpectedly extends production cuts through Q3 — Brent crude surges 4.2% on session open", delay:3600 },
  { text:"Federal Reserve signals rate pause amid recession concerns, Treasury yields fall sharply", delay:4700 },
];

function runDemo() {
  currentGraph = { nodes:[], edges:[], entities:[], headlines:[] };
  document.getElementById('ec-log').innerHTML = '';
  document.getElementById('demo-headlines').innerHTML =
    '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:9px;letter-spacing:.15em;color:#3d4f6a;margin-bottom:4px;">INJECT HEADLINES TO TEST CONNECTOR ↓</div>';
  renderSVG();

  DEMO_HEADLINES.forEach(({ text, delay }) => {
    setTimeout(() => injectHeadline(text), delay);
  });
}

// ═══════════════════════════════════════════
//  CLOCK
// ═══════════════════════════════════════════
function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent =
    now.toISOString().slice(11,19) + ' UTC';
}
setInterval(updateClock, 1000);
updateClock();

// ═══════════════════════════════════════════
//  INJECT INPUT — Enter key
// ═══════════════════════════════════════════
document.getElementById('ec-inject-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') injectHeadline();
});

// ═══════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
  renderSVG();

  // Add demo button to main stub
  const stub = document.querySelector('.main-stub');
  const btn = document.createElement('button');
  btn.textContent = '▶ RUN DEMO — inject all 5 headlines';
  btn.style.cssText = 'margin-top:16px;font-family:IBM Plex Mono,monospace;font-size:10px;letter-spacing:.1em;padding:8px 20px;background:rgba(232,64,64,0.08);border:1px solid rgba(232,64,64,0.3);color:#e84040;border-radius:3px;cursor:pointer;transition:all .15s;';
  btn.onmouseover = () => btn.style.background = 'rgba(232,64,64,0.15)';
  btn.onmouseout = () => btn.style.background = 'rgba(232,64,64,0.08)';
  btn.onclick = runDemo;
  stub.appendChild(btn);
});

window.addEventListener('resize', () => {
  if (currentGraph.nodes.length) renderSVG();
});

// ═══════════════════════════════════════════
//  EXPOSE for integration with other modules
//  e.g. KZ's signal feed can call:
//  window.MacroConnector.injectHeadline(text)
// ═══════════════════════════════════════════
window.MacroConnector = {
  injectHeadline,
  getGraph: () => currentGraph,
  getAssetImpact: (assetName) => {
    const node = currentGraph.nodes.find(n => n.type==='asset' && n.label.toLowerCase()===assetName.toLowerCase());
    if (!node) return null;
    const edges = currentGraph.edges.filter(e=>e.tgt===node.id);
    return {
      asset: assetName,
      lit: !!node,
      direction: node.direction,
      strength: node.strength,
      linkedEntities: edges.map(e => e.src.replace('e:',''))
    };
  }
};
